---
import config from '@/config'

const today = new Date()
---

<footer class="footer">
  <div class="footer-content">
    <div class="copyright">
      <span class="date">&copy; {today.getFullYear()}</span>
      {config.title}
    </div>
  </div>
</footer>

<style>
  @reference "../../styles/global.css";

  .footer {
    @apply text-s text-secondary mt-16 leading-[1.75] font-light opacity-75;
  }

  .footer-content {
    @apply flex w-full flex-row flex-nowrap items-center justify-between;
  }

  .copyright {
    @apply whitespace-nowrap;
  }

  .copyright .date {
    @apply opacity-100;
  }
</style>
