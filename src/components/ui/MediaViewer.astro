<dialog id="media-viewer" aria-label="Media preview">
  <button type="button" autofocus aria-label="Close media preview">Close</button
  >
  <img alt="" hidden />
  <video controls loop muted playsinline hidden></video>
</dialog>

<script>
  import { onPageLoad } from '@/utils/browser-lifecycle'

  onPageLoad(() => {
    const viewer = document.querySelector<HTMLDialogElement>('#media-viewer')
    const image = viewer?.querySelector('img')
    const video = viewer?.querySelector('video')
    const close = viewer?.querySelector('button')
    if (!viewer || !image || !video || !close) return
    const controller = new AbortController()
    const options = { signal: controller.signal }
    const buttons: HTMLButtonElement[] = []
    let previousOverflow = ''
    document
      .querySelectorAll<HTMLImageElement | HTMLVideoElement>(
        '.prose img[data-preview], .prose video[data-preview]'
      )
      .forEach((media) => {
        if (
          media.closest('a, button') ||
          (media instanceof HTMLVideoElement && media.controls)
        )
          return
        const button = document.createElement('button')
        button.type = 'button'
        button.className = 'media-preview-trigger'
        button.setAttribute('aria-haspopup', 'dialog')
        button.setAttribute(
          'aria-label',
          media instanceof HTMLImageElement
            ? `Preview image: ${media.alt || 'Article image'}`
            : 'Preview video'
        )
        media.before(button)
        button.append(media)
        buttons.push(button)
        button.addEventListener(
          'click',
          () => {
            image.hidden = !(media instanceof HTMLImageElement)
            video.hidden = media instanceof HTMLImageElement
            if (media instanceof HTMLImageElement) {
              image.src = media.currentSrc || media.src
              image.alt = media.alt
            } else {
              video.src = media.currentSrc || media.src
            }
            previousOverflow = document.body.style.overflow
            viewer.showModal()
            document.body.style.overflow = 'hidden'
          },
          options
        )
      })
    function reset() {
      video!.pause()
      video!.removeAttribute('src')
      video!.load()
      image!.removeAttribute('src')
      document.body.style.overflow = previousOverflow
    }
    close.addEventListener('click', () => viewer.close(), options)
    viewer.addEventListener(
      'click',
      (event) => {
        if (event.target === viewer) viewer.close()
      },
      options
    )
    viewer.addEventListener('close', reset, options)
    return () => {
      if (viewer.open) {
        viewer.close()
        reset()
      }
      controller.abort()
      buttons.forEach((button) => button.replaceWith(...button.childNodes))
    }
  })
</script>

<style>
  dialog {
    border: 0;
    padding: 3rem 1rem 1rem;
    background: var(--bg);
    color: var(--text-primary);
    max-width: 95vw;
    max-height: 95vh;
  }
  dialog::backdrop {
    background: rgb(0 0 0 / 80%);
  }
  dialog > button {
    position: absolute;
    top: 0.75rem;
    right: 1rem;
    cursor: pointer;
  }
  img,
  video {
    max-width: 85vw;
    max-height: 80vh;
    object-fit: contain;
  }
  :global(.media-preview-trigger) {
    display: block;
    max-width: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: zoom-in;
  }
  :global(.media-preview-trigger:focus-visible) {
    outline: 2px solid currentColor;
    outline-offset: 4px;
  }
</style>
