---
import config from '@/config'
import { httpUrl } from '@/utils/embed'

type Props = { url: string; maxWidth?: number }
const { url, maxWidth = 800 } = Astro.props
const source = httpUrl(url)
if (!source) throw new Error('Embed URL must use HTTP or HTTPS')
if (
  new URL(config.workerHost).origin === new URL(Astro.site ?? Astro.url).origin
) {
  throw new Error(
    'PUBLIC_WORKER_HOST must use a separate origin for rich embeds'
  )
}
---

<div
  class="oembed-container"
  data-url={source}
  data-worker={config.workerHost}
  style={`max-width: ${maxWidth}px`}
>
  <div class="oembed-content"></div>
  <a href={source} target="_blank" rel="noopener noreferrer"
    >View original post</a
  >
</div>

<script>
  import { onPageLoad } from '@/utils/browser-lifecycle'
  import { parseEmbed, embedHeight } from '@/utils/embed'

  function loadEmbeds() {
    const controller = new AbortController()
    const frames = new Map<HTMLIFrameElement, string>()
    window.addEventListener(
      'message',
      (event) => {
        const height = embedHeight(event.data)
        if (height === null) return
        for (const [frame, origin] of frames) {
          if (event.source === frame.contentWindow && event.origin === origin) {
            frame.style.height = `${height}px`
            break
          }
        }
      },
      { signal: controller.signal }
    )
    const containers =
      document.querySelectorAll<HTMLElement>('.oembed-container')
    for (const container of containers) {
      const content = container.querySelector<HTMLElement>('.oembed-content')
      const worker = container.dataset.worker
      const source = container.dataset.url
      if (!content || !worker || !source) continue
      const theme =
        document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
      const endpoint = new URL(`${worker}/oembed`)
      // Also protect local previews and accidental same-origin runtime configuration.
      if (endpoint.origin === location.origin) continue
      endpoint.searchParams.set('url', source)
      endpoint.searchParams.set('theme', theme)
      void fetch(endpoint, {
        signal: AbortSignal.any([
          controller.signal,
          AbortSignal.timeout(10000),
        ]),
      })
        .then(async (response) => {
          if (!response.ok) throw new Error(`Embed HTTP ${response.status}`)
          const data = parseEmbed(await response.json())
          if (!data || controller.signal.aborted) return
          if (data.type === 'photo' && data.url) {
            const image = document.createElement('img')
            image.src = data.url
            image.alt = data.title || ''
            image.loading = 'lazy'
            image.style.maxWidth = '100%'
            content.replaceChildren(image)
          } else if (data.type === 'link' && data.url) {
            const link = document.createElement('a')
            link.href = data.url
            link.textContent = data.title || data.url
            link.target = '_blank'
            link.rel = 'noopener noreferrer'
            content.replaceChildren(link)
          } else if (data.html) {
            const frame = document.createElement('iframe')
            frame.title = 'Embedded post'
            // Execute provider HTML on the worker's separate, public origin.
            // Do not sandbox it to an opaque origin: nested provider CORS needs
            // its real origin. Never assign worker HTML to srcdoc or our DOM.
            const renderUrl = new URL(`${worker}/oembed/render`)
            renderUrl.search = endpoint.search
            frame.src = renderUrl.href
            frame.referrerPolicy = 'no-referrer'
            frame.loading = 'lazy'
            frame.style.cssText = 'width:100%;height:600px;border:0'
            frames.set(frame, renderUrl.origin)
            content.replaceChildren(frame)
          }
        })
        .catch(() => {
          // The persistent source link remains usable on timeout/provider failure.
        })
    }
    return () => {
      controller.abort()
      frames.clear()
    }
  }

  onPageLoad(() => {
    let cleanup = loadEmbeds()
    const observer = new MutationObserver(() => {
      cleanup()
      cleanup = loadEmbeds()
    })
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    })
    return () => {
      observer.disconnect()
      cleanup()
    }
  })
</script>

<style>
  .oembed-container {
    margin-block: 1rem;
    width: 100%;
  }
</style>
