---
import config from '@/config'
import { httpUrl } from '@/utils/embed'

type Props = { url: string; maxWidth?: number }
const { url, maxWidth = 800 } = Astro.props
const source = httpUrl(url)
if (!source) throw new Error('Embed URL must use HTTP or HTTPS')
---

<div
  class="oembed-container"
  data-url={source}
  data-worker={config.workerHost}
  style={`max-width: ${maxWidth}px`}
>
  <div class="oembed-content"></div>
  <a href={source} target="_blank" rel="noopener noreferrer"
    >View original post</a
  >
</div>

<script>
  import { onPageLoad } from '@/utils/browser-lifecycle'
  import { parseEmbed } from '@/utils/embed'

  function loadEmbeds() {
    const controller = new AbortController()
    const containers =
      document.querySelectorAll<HTMLElement>('.oembed-container')
    for (const container of containers) {
      const content = container.querySelector<HTMLElement>('.oembed-content')
      const worker = container.dataset.worker
      const source = container.dataset.url
      if (!content || !worker || !source) continue
      const endpoint = new URL(`${worker}/oembed`)
      endpoint.searchParams.set('url', source)
      endpoint.searchParams.set(
        'theme',
        document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light'
      )
      void fetch(endpoint, {
        signal: AbortSignal.any([
          controller.signal,
          AbortSignal.timeout(10000),
        ]),
      })
        .then(async (response) => {
          if (!response.ok) throw new Error(`Embed HTTP ${response.status}`)
          const data = parseEmbed(await response.json())
          if (!data || controller.signal.aborted) return
          if (data.type === 'photo' && data.url) {
            const image = document.createElement('img')
            image.src = data.url
            image.alt = data.title || ''
            image.loading = 'lazy'
            image.style.maxWidth = '100%'
            content.replaceChildren(image)
          } else if (data.type === 'link' && data.url) {
            const link = document.createElement('a')
            link.href = data.url
            link.textContent = data.title || data.url
            link.target = '_blank'
            link.rel = 'noopener noreferrer'
            content.replaceChildren(link)
          } else if (data.html) {
            const frame = document.createElement('iframe')
            frame.title = 'Embedded post'
            // Opaque origin: provider scripts cannot access our document or storage.
            // No top navigation, forms, popups, or same-origin permission.
            frame.setAttribute('sandbox', 'allow-scripts')
            frame.referrerPolicy = 'no-referrer'
            frame.loading = 'lazy'
            frame.style.cssText = 'width:100%;height:600px;border:0'
            frame.srcdoc = `<!doctype html><html><head><meta charset="utf-8"><meta name="referrer" content="no-referrer"></head><body>${data.html}</body></html>`
            content.replaceChildren(frame)
          }
        })
        .catch(() => {
          // The persistent source link remains usable on timeout/provider failure.
        })
    }
    return () => controller.abort()
  }

  onPageLoad(() => {
    let cleanup = loadEmbeds()
    const observer = new MutationObserver(() => {
      cleanup()
      cleanup = loadEmbeds()
    })
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    })
    return () => {
      observer.disconnect()
      cleanup()
    }
  })
</script>

<style>
  .oembed-container {
    margin-block: 1rem;
    width: 100%;
  }
</style>
