---
import type { CollectionEntry } from 'astro:content'
import WritingListItem from '@/components/widgets/WritingListItem.astro'

type Props = {
  writings: CollectionEntry<'writings'>[]
}

const { writings } = Astro.props
---

<ul class="m-0 flex list-none flex-col p-0">
  {writings.map((writing) => (
    <WritingListItem writing={writing} />
  ))}
</ul>
<div class="h-12"></div>

<style>
  @reference "../../styles/global.css";

  @media (hover: hover) and (pointer: fine) {
    ul:hover :global(a) {
      @apply opacity-40;
    }

    ul:hover :global(li:hover a) {
      @apply opacity-100;
    }

    ul:hover :global(li:hover .divider) {
      @apply bg-tertiary opacity-75;
    }

    ul:hover :global(li:hover .post-date) {
      @apply text-secondary opacity-100;
    }
  }
</style>
