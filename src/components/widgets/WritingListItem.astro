---
import type { CollectionEntry } from 'astro:content'
import { formatDate } from '@/utils/date'
import { getDisplayDate } from '@/utils/writing'

type Props = {
  writing: CollectionEntry<'writings'>
}

const { writing } = Astro.props
const displayDate = getDisplayDate(writing)
---

<li class="m-0 list-none p-0">
  <a
    href={`/writing/${writing.id}`}
    class="text-primary block no-underline transition-opacity duration-150 ease-out"
  >
    <div class="flex h-11 items-center justify-between gap-3">
      <p class="m-0 min-w-0 shrink overflow-hidden text-ellipsis whitespace-nowrap">
        {writing.data.title}
      </p>
      <div class="divider bg-border mx-1 h-[0.5px] min-w-12 flex-auto"></div>
      <p class="date m-0 shrink-0 whitespace-nowrap">
        {formatDate(displayDate)}
      </p>
    </div>
  </a>
</li>
